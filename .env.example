# Vercel Preview and Production runtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_secret
APM_SESSION_SECRET=replace_with_random_secret_at_least_32_characters
APM_DEV_AUTO_LOGIN=false

# Local import, seed, and database verification only
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
APM_OWNER_ID=replace_with_uuid
APM_OWNER_ACCESS_CODE=replace_with_random_access_code_at_least_20_characters
KB_SOURCE_PATH=/absolute/path/to/AI-PM-guide
