{
  "name": "recall-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:prepare": "node --import tsx scripts/prepare-content.ts",
    "db:inspect": "node scripts/inspect-database.mjs",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:verify": "node --import tsx scripts/verify-database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.2",
    "date-fns-tz": "3.2.0",
    "lucide-react": "0.563.0",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
